{
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "auth-service",
        "AuthorizationPolicy": "Administrators",
        "Match": {
          "Path": "/api/users/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "roles": {
        "ClusterId": "auth-service",
        "AuthorizationPolicy": "Administrators",
        "Match": {
          "Path": "/api/roles/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "reports": {
        "ClusterId": "report-service",
        "AuthorizationPolicy": "Administrators",
        "Match": {
          "Path": "/api/reports/{**remainder}"
        }
      },
      "audit": {
        "ClusterId": "audit-service",
        "AuthorizationPolicy": "Administrators",
        "Match": {
          "Path": "/api/audit/events",
          "Methods": [
            "GET"
          ]
        }
      }
    },
    "Clusters": {
      "report-service": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:8000/"
          }
        }
      },
      "sensor-service": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5026/"
          }
        }
      },
      "audit-service": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:8001/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "Audit": {
    "Enabled": true,
    "IngestUrl": "http://127.0.0.1:8001/internal/events"
  }
}
