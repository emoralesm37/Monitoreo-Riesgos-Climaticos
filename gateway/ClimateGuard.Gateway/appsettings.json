{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "communities": {
        "ClusterId": "legacy-api",
        "Match": {
          "Path": "/api/communities/{**remainder}"
        }
      },
      "sensors": {
        "ClusterId": "legacy-api",
        "Match": {
          "Path": "/api/sensors/{**remainder}"
        }
      },
      "catalogs": {
        "ClusterId": "legacy-api",
        "Match": {
          "Path": "/api/catalogs/{**remainder}"
        }
      },
      "alert-rules": {
        "ClusterId": "legacy-api",
        "Match": {
          "Path": "/api/alert-rules/{**remainder}"
        }
      },
      "audit": {
        "ClusterId": "audit-service",
        "Match": {
          "Path": "/api/audit/{**remainder}"
        }
      },
      "physical-sensors": {
        "ClusterId": "sensor-service",
        "Match": {
          "Path": "/api/physical-sensors/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/sensors/{**remainder}"
          }
        ]
      },
      "physical-sensor-types": {
        "ClusterId": "sensor-service",
        "Match": {
          "Path": "/api/physical-sensor-types"
        },
        "Transforms": [
          {
            "PathSet": "/api/sensor-types"
          }
        ]
      }
    },
    "Clusters": {
      "auth-service": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:7101/"
          }
        }
      },
      "legacy-api": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:7000/"
          }
        }
      },
      "audit-service": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:8001/"
          }
        }
      },
      "sensor-service": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5026/"
          }
        }
      }
    }
  }
}
