# ClimateGuard - Configuración del agente Python

# Modalidad: simulation o serial
ARDUINO_AGENT_MODE=simulation

# Envío de mediciones a Gateway
# false = pruebas locales
# true = envío habilitado
ARDUINO_SEND_ENABLED=true

# Servicios ClimateGuard
CLIMATEGUARD_GATEWAY_URL=http://localhost:5147
CLIMATEGUARD_AUTH_URL=http://localhost:7101

# Credenciales de autenticación
# Configurar mediante variables de entorno seguras
CLIMATEGUARD_AGENT_EMAIL=
CLIMATEGUARD_AGENT_PASSWORD=

# Intervalo de simulación (segundos)
ARDUINO_SIMULATION_INTERVAL=10

# Configuración serial de Arduino Uno
ARDUINO_SERIAL_PORT=/dev/ttyACM0
ARDUINO_SERIAL_BAUDRATE=9600
