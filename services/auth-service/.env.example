NODE_ENV=development
PORT=7101

DB_HOST=localhost
DB_PORT=5432
DB_NAME=climateguard_auth
DB_USER=climateguard_auth
DB_PASSWORD=replace_with_a_secure_password
DB_SSL=false

JWT_ACCESS_SECRET=replace_with_a_secure_access_secret
JWT_ACCESS_TTL_SECONDS=900

JWT_REFRESH_SECRET=replace_with_a_different_refresh_secret
JWT_REFRESH_TTL_SECONDS=604800

JWT_ISSUER=ClimateGuard.Auth
JWT_AUDIENCE=ClimateGuard.Services

INITIAL_ADMIN_NAME=Administrador ClimateGuard
INITIAL_ADMIN_EMAIL=admin@climateguard.local
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_admin_password

GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:7101/auth/callback/google

GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:7101/auth/callback/github