# Merge variable names into your private environment. Never replace existing DB/JWT credentials.
OAUTH_FRONTEND_URL=http://localhost:4200
GOOGLE_CALLBACK_URL=http://localhost:5147/api/auth/callback/google
GITHUB_CALLBACK_URL=http://localhost:5147/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Separate 32-byte random encryption key, encoded as 64 hex characters.
# Provision privately; do not reuse JWT keys. Keep stable across Auth replicas/restarts.
OAUTH_SESSION_KEY=
# Optional isolation for local integration tests. Default public preserves existing configuration.
DB_SCHEMA=public
