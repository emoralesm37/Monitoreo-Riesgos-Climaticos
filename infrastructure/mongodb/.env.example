# LOCAL ONLY. Copy to .env without overwriting an existing file.
# Replace placeholders privately before use. This file contains no real secrets.
# Use dotenv/Bash-compatible assignments; single-quote values with special characters.
MONGO_ROOT_USERNAME=climateguard_local_root
MONGO_ROOT_PASSWORD=
MONGO_REPORT_USERNAME=climateguard_local_reports
MONGO_REPORT_PASSWORD=
# Existing script also provisions the audit user; this does not start Audit Service.
MONGO_AUDIT_USERNAME=climateguard_local_audit
MONGO_AUDIT_PASSWORD=
# Independent service-to-service signing key, not a user password or JWT key.
# services/audit-service/configure-local.cjs generates it privately when missing.
AUDIT_INGEST_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS

# Report Service runs on the host in this local scenario.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
# Must match the database and readWrite role in create-users.sh.
MONGO_DATABASE=ClimateGuardReports

# Match LOCAL Auth and Gateway values; never use production credentials.
JWT_ACCESS_SECRET=
JWT_ISSUER=REPLACE_WITH_LOCAL_AUTH_ISSUER
JWT_AUDIENCE=REPLACE_WITH_LOCAL_AUTH_AUDIENCE
COMMUNITY_SERVICE_URL=http://localhost:5147
